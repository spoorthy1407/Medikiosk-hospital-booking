# MediKiosk settings. Copy this file to a file named  .env  (same folder as app.py), fill in your values, run: python app.py
# Never share or upload .env - it holds passwords. (.gitignore already keeps it out of GitHub.)

# ---- Database: leave empty to use the built-in local file. Neon example below ----
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# ---- Security ----
# SECRET_KEY=any-long-random-text
# STAFF_USERNAME=admin
# STAFF_PASSWORD=choose-a-strong-password      (only used the first time the staff account is created)

# ---- n8n (local). Set USE_N8N=0 to run without n8n ----
USE_N8N=1
N8N_TRIAGE_URL=http://localhost:5678/webhook/medikiosk-triage
N8N_NOTIFY_URL=http://localhost:5678/webhook/medikiosk-booked
N8N_TRIAGE_TIMEOUT=40
N8N_RETRY_SECONDS=120

# ---- E-mail used when n8n is off or down, and for tablet reminders (pick ONE) ----
# BREVO_API_KEY=your-brevo-key
# EMAIL_FROM=your-verified-sender@gmail.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-gmail-app-password
RECEPTIONIST_EMAIL=spoorthykamireddygari@gmail.com

# ---- Optional ----
# APP_TIMEZONE=Asia/Kolkata
